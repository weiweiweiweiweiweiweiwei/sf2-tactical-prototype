node_modules/
tools/out/
.claude/settings.local.json
_v*_test.html
ref/*.webp
ref/*.png
tools/ryokan/plan.json
tools/ryokan/ryokan.glb

# walkable .blend copies of the maps + their exported textures (tools/_matexport.mjs, glb_to_blend.py, blend_sky.py) — large, local only
maps/*/view/

# Blender python caches; Satellite Base intermediates (rebuilt by tools/satellite/export_plan.mjs + tools/blender/sat_build.py; the game ships assets/maps/satellite.js)
__pycache__/
tools/satellite/plan.json
tools/satellite/satellite.glb

# Blender MCP bridge logs (tools/blender/verify_mcp.py)
tools/blender/mcp_*.log

# Apex exports: the game reads only the script packs (assets/maps/apex-*/pack/, tools/pack-apex-js.mjs); the raw
# exports they are built from stay local (rebuilt by the Blender scripts in docs/apex-full-checklist.md)
assets/maps/apex-test/region.glb
assets/maps/apex-full/*
!assets/maps/apex-full/pack/

# second Claude Code account works in its own git worktree (COLLAB.md)
.worktrees/

# Apex Legends originals exported from the user's install (RSX, loop H5) — EA's assets: kept on the user's machine only, never published (user 10-28: 5A)
tools/guns/apex_*
