# 複製成 .env 後修改（環境變數也可以；兩者都有時以環境變數為準）
PORT=8787
HOST=0.0.0.0
# 好友資料存放的資料夾（相對於 server/）
DATA_DIR=data
# 允許哪些網站的遊戲頁面連進來，逗號分隔。http://localhost 與 http://127.0.0.1 代表任何連接埠；null 是直接雙擊打開的本機檔案。
# 伺服器自己提供遊戲網頁（STATIC_DIR）時，同網址一律允許，不用寫在這裡。
ALLOWED_ORIGINS=https://weiweiweiweiweiweiweiwei.github.io,http://localhost,http://127.0.0.1,null
# 放在 nginx / Caddy 後面時設 1，才會用 X-Forwarded-For 判斷真實 IP（限流用）
TRUST_PROXY=1
# 選用：讓這台伺服器也提供遊戲網頁。指向只放 index.html 與 assets/ 等發佈檔案的資料夾，不要指向整個專案。
# STATIC_DIR=/srv/sf2/www

# 選用：TURN 中繼（網路很嚴格、無法直連的玩家需要）。三種擇一：
# 1) 自架 coturn（static-auth-secret 模式）
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=跟 coturn 設定裡 static-auth-secret 相同的字串
# TURN_TTL=7200
# 2) Metered（每月 500 MB 免費）
# METERED_APP=yourapp
# METERED_API_KEY=...
# 3) Cloudflare（每月 1000 GB 免費，需綁卡）
# CF_TURN_KEY_ID=...
# CF_TURN_TOKEN=...

# 限流（通常不用改）：同一 IP 最多幾條連線、每分鐘幾次 API
# CONNS_PER_IP=50
# RPC_PER_MIN=600
